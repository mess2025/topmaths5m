<!-- Modèle : grille de toutes les animations (page Animations) -->
```{=html}
<div class="grilleanimations">
<% for (const item of items) { %>
<a href="<%- item.path %>" class="vignette" <%= metadataAttrs(item) %>>
<div class="image"><img src="<%- item.image %>" alt=""></div>
<div class="titre"><%= item.titrecourt || item.title %></div>   <!-- titre court s'il existe, sinon le titre complet -->
<% if (item.domaine) { %><div class="domaine"><%= item.domaine %></div><% } %>   <!-- domaine : Algèbre, Analyse… -->
</a>
<% } %>
</div>
```
